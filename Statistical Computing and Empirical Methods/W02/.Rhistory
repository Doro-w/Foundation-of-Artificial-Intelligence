#' Required variables: bayes_positive (function)
#' Required plots:
bayes_positive <- function(prevalence,
sensitivity,
specificity){
# Enter the body of the function here and
# don't forget to return() your result.
posterior <- (prevalence * sensitivity) /
(prevalence * sensitivity +
(1 - prevalence) * (1 - specificity))
return(posterior)
}
#' Required variables:
#' Required plots:
bayes_positive(
prevalence = 0.2,
sensitivity = 0.98,
specificity = 0.95
)
#' Required variables:
#' Required plots:
# Input data frame
X <- data.frame(prev = c(.01, .05, .2),
sens = c(.99, .95, .90),
spec = c(.99, .98, .95))
# Now enter your solution below
X$posterior <- mapply(
bayes_positive,
prevalence = X$prev,
sensitivity = X$sens,
specificity = X$spec
)
X
#' Required variables:
#' Required plots:
library(dplyr)
# Generate simulated population
prevalence  <- .05
sensitivity <- .98
specificity <- .95
# simulated population
population <- data.frame(person = 1:10000,
disease = rbinom(10000,
size = 1,
prob = prevalence)) %>%
mutate(positive = ifelse(disease == 1,
yes = rbinom(n(), 1, sensitivity),
no  = rbinom(n(), 1, 1 - specificity)))
# Now enter your solution below
sum(population$positive == 1)
sum(population$disease == 1)
sum(population$positive == 1 &
population$disease == 1)
population %>%
filter(positive == 1) %>%
summarise(
posterior = mean(disease)
)
#' Required variables:
#' Required plots:
library(dplyr)
# Generate simulated population
prevalence  <- .05
sensitivity <- .98
specificity <- .95
# simulated population
population <- data.frame(person = 1:10000,
disease = rbinom(10000,
size = 1,
prob = prevalence)) %>%
mutate(positive = ifelse(disease == 1,
yes = rbinom(n(), 1, sensitivity),
no  = rbinom(n(), 1, 1 - specificity)))
# Now enter your solution below
sum(population$positive == 1)
sum(population$disease == 1)
sum(population$positive == 1 &
population$disease == 1)
population %>%
summarise(
posterior =
sum(disease == 1 & positive == 1) /
sum(positive == 1)
)
